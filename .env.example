# ─── Site ───────────────────────────────────────────────────────────────────
# Your production URL (https://your-domain.com, no trailing slash). Used only
# to resolve absolute og:image/twitter:image URLs. Leave unset in dev — Next
# falls back to localhost and prints a build-time warning, which is fine
# there; set this before deploying so social share previews aren't broken.
NEXT_PUBLIC_APP_URL=

# ─── Database ───────────────────────────────────────────────────────────────
# Any Postgres wire-protocol connection string works: Neon, Supabase, Docker
# (see docker-compose.yml), or the zero-setup local dev server:
#   npm run db:dev   # starts an embedded Postgres-compatible server
DATABASE_URL=postgres://doubloon:doubloon@127.0.0.1:55432/doubloon

# ─── AI ─────────────────────────────────────────────────────────────────────
# Leave ANTHROPIC_API_KEY unset to run AI features in demo mode (canned but
# realistic structured responses) — the full product loop stays testable
# without a key.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8

# ─── Billing ────────────────────────────────────────────────────────────────
# A Stripe Payment Link URL. When set, every "Upgrade" button points here.
# Configure the link's confirmation page to redirect to:
#   https://<your-domain>/dashboard?checkout_session_id={CHECKOUT_SESSION_ID}
STRIPE_PAYMENT_LINK=
# Signing secret for the /api/stripe/webhook endpoint (whsec_...).
STRIPE_WEBHOOK_SECRET=
# Secret API key (sk_...), used only to open a Stripe Billing Portal session
# from Settings → Plan & billing → Manage billing. Leave unset and the
# button stays hidden — everything else in this app works without it.
STRIPE_SECRET_KEY=

# ─── Bank connections (Plaid / TrueLayer) ─────────────────────────────────────
# Symmetric key used to encrypt stored access/refresh tokens at rest (see
# src/lib/security/token-encryption.ts). Required for either provider below
# to be enabled — generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Leave unset and PlaidImportProvider stays disabled; everything else in this
# app works without it. See src/lib/imports/providers/plaid-provider.ts.
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | development | production — see https://plaid.com/docs/api/#environments
PLAID_ENV=sandbox

# Leave unset and TrueLayerImportProvider stays disabled; everything else in
# this app works without it. See
# src/lib/imports/providers/truelayer-provider.ts.
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
# sandbox | live — see https://docs.truelayer.com/docs/environments
TRUELAYER_ENV=sandbox
